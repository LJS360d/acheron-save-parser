// .vscode/tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate, Compare and Move",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Generate all GBA -> JSON data",
        "Generate All Docs data",
        "Move docs data to docs prj",
      ],
      "group": {
        "kind": "build",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate all GBA -> JSON data",
      "type": "shell",
      "dependsOn": [
        "Generate JSON data (Our)",
        "Generate JSON data (Rhh)"
      ],
      "group": {
        "kind": "build",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate JSON data (Our)",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/cmd",
        "-gba='test/gba/acheron-emerald.gba'",
        "-o='species,evolutions,moves,learnsets,items,encounters'",
        "-jbp=our_"
      ],
      "group": {
        "kind": "build",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Sprites (Our)",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/cmd",
        "-gba='test/gba/acheron-emerald.gba'",
        "-o='sprites'",
      ],
      "group": {
        "kind": "build",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate JSON data (Rhh)",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/cmd",
        "-gba='test/gba/rhh1.11.8.gba'",
        "-o='species,evolutions,moves,learnsets,items,encounters'",
        "-jbp=rhh_"
      ],
      "group": {
        "kind": "build",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate All Docs data",
      "type": "shell",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Generate Pokemon Docs data",
        "Generate Learnsets Docs data",
        "Generate Evolutions Docs data",
        "Generate Moves Docs data",
        "Generate Items Docs data",
        "Generate Wild Encounters Docs data"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Pokemon Docs data",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/scripts/build_compare.go",
        "-new='./build/our_species.json'",
        "-old='./build/rhh_species.json'",
        "-id='id'",
        "-o='./build/pokemon.json'",
        "-d"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Learnsets Docs data",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/scripts/build_compare.go",
        "-new='./build/our_learnsets.json'",
        "-old='./build/rhh_learnsets.json'",
        "-id='species'",
        "-o='./build/learnsets.json'",
        "-d"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Evolutions Docs data",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/scripts/build_compare.go",
        "-new='./build/our_evolutions.json'",
        "-old='./build/rhh_evolutions.json'",
        "-id='family'",
        "-o='./build/evolutions.json'",
        "-s",
        "-d"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Items Docs data",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/scripts/build_compare.go",
        "-new='./build/our_items.json'",
        "-old='./build/rhh_items.json'",
        "-id='id'",
        "-o='./build/items.json'",
        "-s",
        "-d"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Moves Docs data",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/scripts/build_compare.go",
        "-new='./build/our_moves.json'",
        "-old='./build/rhh_moves.json'",
        "-id='id'",
        "-o='./build/moves.json'",
        "-s",
        "-d"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Wild Encounters Docs data",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "${workspaceFolder}/scripts/build_compare.go",
        "-new='./build/our_wild_encounters.json'",
        "-old='./build/rhh_wild_encounters.json'",
        "-id='mapNum'",
        "-o='./build/wild_encounters.json'",
        "-s",
        "-d"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    },
    {
      "label": "Move docs data to docs prj",
      "type": "shell",
      "command": "mv",
      "args": [
        "-Force",
        "./build/*.json",
        "../docs/src/data/"
      ],
      "group": {
        "kind": "none",
      },
      "problemMatcher": []
    }
  ]
}